{
  "name": "last-alchemist",
  "version": "0.1.0",
  "private": true,
  "description": "Книга последнего алхимика — алхимическая головоломка для Яндекс Игр",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode yandex",
    "build:local": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "pack": "npm run build && tsx tools/pack-yandex.ts",
    "verify:zip": "tsx tools/verify-zip.ts",
    "check": "npm run lint && npm run typecheck && npm run content:check && npm run test && npm run pack && npm run test:e2e",
    "content:check": "tsx tools/content-check.ts",
    "art": "tsx tools/art/render.ts",
    "art:textures": "tsx tools/art/textures.ts",
    "audio": "tsx tools/audio/synth.ts",
    "music": "tsx tools/audio/music.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/ysdk": "^1.2.0",
    "eslint": "^10.13.0",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/marck-script": "^5.3.0"
  }
}
